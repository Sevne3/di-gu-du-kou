"use client";
import { useEffect, useState } from "react";
import { getMe } from "@/lib/api";
import Link from "next/link";

export default function Home() {
  const [user, setUser] = useState(null);
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => {
    getMe().then((data) => setUser(data.user)).catch(() => {});
    const onScroll = () => setScrolled(window.scrollY > 60);
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  useEffect(() => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add("visible"); });
    }, { threshold: 0.08, rootMargin: "0px 0px -30px 0px" });
    document.querySelectorAll(".anim").forEach(el => observer.observe(el));
    return () => observer.disconnect();
  }, []);

  const handleJoin = async (e) => {
    e.preventDefault();
    const form = e.target;
    const contact = form.contact.value.trim();
    if (!contact) { alert("留个联系方式吧"); return; }
    alert("谢谢你来到这里。社群上线后我会第一个联系你。");
    form.reset();
  };

  const sections = [
    { id: "about", title: "低谷渡口是", cards: [
      { icon: "🌊", title: "一个渡口", desc: "不是你永远待的地方。是你路过、休息、被托住，然后继续往前走的地方。" },
      { icon: "👥", title: "一个社群", desc: "不是求职平台，不是课程商城。是一群真实的人，互相说"我也是"的地方。" },
      { icon: "🕯️", title: "一盏灯", desc: "在黑的时候，有人为你亮着。等你亮了，也可以为下一个人亮着。" },
    ]}
  ];

  const whoItems = [
    ["💳","负债的人","不是"不会理财"，只是暂时被困住了。这里没人会judge你的账单。"],
    ["💼","失业的人","不是"不够努力"，只是风口没吹到你。这里不需要伪装"我很好"。"],
    ["🏠","想逃离原生家庭的人","不是"不孝顺"，只是太累了。这里有人懂那种"家不是退路"的感觉。"],
  ];

  const features = [
    { icon: "🌱", title: "治愈打卡", desc: "每天一个温柔的提问：「今天，你照顾自己了吗？」", note: "打卡不是为了卷，是让你看见每天都有在走。" },
    { icon: "🌙", title: "深夜陪伴", desc: "凌晨三点睡不着的时候，打开社群。有人在。", note: "你不必一个人熬过那些夜晚。" },
    { icon: "🤝", title: "互帮互助", desc: "如果你有余力——分享信息、教一个技能、或者只是倾听。", note: "帮不帮，节奏你自己定。" },
    { icon: "🛡️", title: "没有噪音", desc: "没有广告，没有炫富帖。不评判、不建议、不比较。", note: "累了就安静待着。" },
  ];

  return (
    <>
      <style>{/*css*/
        .hero{position:relative;min-height:100vh;display:flex;flex-direction:column;background:linear-gradient(160deg,#16213e 0%,#1a1a2e 30%,#2d2d44 60%,#1a1a2e 100%);overflow:hidden}
        .particle{position:absolute;border-radius:50%;background:rgba(240,194,127,.2);animation:floatUp 8s ease-in-out infinite}
        @keyframes floatUp{0%,100%{transform:translateY(0)scale(1);opacity:.3}50%{transform:translateY(-40px)scale(1.5);opacity:.8}}
        .nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:18px 0;transition:.5s}
        .nav.scrolled{background:rgba(26,26,46,.85);backdrop-filter:blur(20px);padding:10px 0}
        .nav__inner{display:flex;align-items:center;justify-content:space-between;max-width:780px;margin:0 auto;padding:0 24px}
        .nav__logo{font-size:1.2rem;font-weight:700;color:var(--cream);letter-spacing:1px}
        .nav__links{display:flex;align-items:center;gap:24px}
        .nav__links a{font-size:.9rem;color:rgba(255,255,255,.7)}.nav__links a:hover{color:var(--warm-glow)}
        .nav__cta{background:var(--warm-glow);color:var(--night)!important;padding:8px 20px;border-radius:40px;font-weight:600!important;font-size:.85rem!important}
        @media(max-width:640px){.nav__links a:not(.nav__cta){display:none}}
        .hero__body{flex:1;display:flex;align-items:center;padding:120px 0 60px;position:relative;z-index:2}
        .hero__text{max-width:600px}
        .hero__badge{display:inline-block;padding:6px 18px;border-radius:40px;font-size:.82rem;font-weight:500;color:var(--warm-glow);background:rgba(240,194,127,.1);border:1px solid rgba(240,194,127,.15);margin-bottom:28px;letter-spacing:2px}
        .hero__title{font-size:clamp(2.4rem,6vw,3.6rem);font-weight:700;line-height:1.2;color:var(--cream);margin-bottom:8px}
        .hero__subtitle{display:block;font-size:clamp(1.1rem,2.5vw,1.4rem);font-weight:400;color:var(--warm-glow);margin-top:8px;letter-spacing:6px;opacity:.8}
        .hero__desc{font-size:1.1rem;color:rgba(250,246,240,.6);line-height:2;margin:24px 0 36px}
        .hero__actions{display:flex;gap:16px;flex-wrap:wrap}
        .hero__wave{position:relative;z-index:2;line-height:0;margin-top:-2px}
        .hero__wave svg{display:block;width:100%;height:80px}
        .section{padding:100px 0;opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease}
        .section.visible{opacity:1;transform:translateY(0)}
        .section--cream{background:var(--cream-dark)}
        .section--join{background:linear-gradient(160deg,#faf6f0 0%,#f0e8dc 100%)}
        .section__title{font-size:clamp(1.6rem,3.5vw,2.2rem);font-weight:700;text-align:center;color:var(--night);margin-bottom:48px}
        .about__cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px}
        .about__card{text-align:center;padding:40px 24px 32px;background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);transition:var(--transition);opacity:0;transform:translateY(24px)}
        .about__card.visible{opacity:1;transform:translateY(0)}
        .about__card:hover{transform:translateY(-6px);box-shadow:var(--shadow-hover)}
        .about__icon{font-size:2.6rem;display:block;margin-bottom:16px}
        .about__card h3{font-size:1.15rem;font-weight:700;margin-bottom:10px;color:var(--night)}
        .about__card p{font-size:.93rem;color:var(--text-light);line-height:1.9}
        .who__list{max-width:540px;margin:0 auto 40px;display:flex;flex-direction:column;gap:20px}
        .who__item{display:flex;align-items:flex-start;gap:18px;background:var(--white);padding:24px;border-radius:var(--radius-sm);box-shadow:var(--shadow);transition:var(--transition);opacity:0;transform:translateY(24px)}
        .who__item.visible{opacity:1;transform:translateY(0)}
        .who__item:hover{transform:translateX(6px)}
        .who__emoji{font-size:1.8rem}
        .who__item strong{display:block;font-size:1.05rem;color:var(--night);margin-bottom:4px}
        .who__item p{font-size:.92rem;color:var(--text-light);line-height:1.8}
        .who__note{text-align:center;padding:24px;background:var(--white);border-radius:var(--radius-sm);max-width:540px;margin:0 auto;border-left:4px solid var(--warm-glow)}
        .who__note p{font-size:.95rem;color:var(--text-light)}.who__note strong{color:var(--night)}
        .features__grid{display:flex;flex-direction:column;gap:24px;max-width:640px;margin:0 auto 48px}
        .feature-card{background:var(--white);padding:32px 28px;border-radius:var(--radius);box-shadow:var(--shadow);transition:var(--transition);opacity:0;transform:translateY(24px)}
        .feature-card.visible{opacity:1;transform:translateY(0)}
        .feature-card:hover{transform:translateY(-4px)}
        .fc-icon{width:52px;height:52px;display:flex;align-items:center;justify-content:center;background:var(--warm-glow-dim);border-radius:16px;margin-bottom:16px;font-size:1.5rem}
        .feature-card h3{font-size:1.1rem;font-weight:700;color:var(--night);margin-bottom:10px}
        .feature-card p{font-size:.93rem;color:var(--text-light);line-height:1.9}
        .fc-footnote{margin-top:14px;padding-top:14px;border-top:1px solid rgba(240,194,127,.15);font-size:.88rem;color:var(--text-muted)}
        .fc-footnote strong{color:var(--warm-glow)}
        .covenant{text-align:center;max-width:500px;margin:0 auto;padding:40px 32px;background:linear-gradient(135deg,var(--night) 0%,var(--night-light) 100%);border-radius:var(--radius);opacity:0;transform:scale(.95);transition:opacity .8s ease,transform .8s ease}
        .covenant.visible{opacity:1;transform:scale(1)}
        .covenant blockquote{font-size:1.05rem;color:rgba(250,246,240,.75);line-height:2;font-style:italic}
        .covenant cite{display:block;margin-top:16px;font-style:normal;font-size:.85rem;color:var(--warm-glow);opacity:.7}
        .join__card{max-width:520px;margin:0 auto;background:var(--white);border-radius:var(--radius);padding:48px 40px;box-shadow:var(--shadow)}
        .join__title{font-size:1.6rem;font-weight:700;color:var(--night);text-align:center;margin-bottom:10px}
        .join__desc{text-align:center;color:var(--text-light);font-size:.95rem;line-height:1.9;margin-bottom:28px}
        .join__desc strong{color:var(--warm-glow)}
        .join__form{display:flex;flex-direction:column;gap:14px;max-width:400px;margin:0 auto}
        .join__input{width:100%;padding:14px 18px;border-radius:var(--radius-sm);border:1.5px solid #eee;background:var(--cream);color:var(--text);font-size:.93rem;font-family:inherit;outline:none;transition:var(--transition)}
        .join__input:focus{border-color:var(--warm-glow);background:var(--white);box-shadow:0 0 0 4px rgba(240,194,127,.08)}
        .join__footnote{text-align:center;color:var(--text-muted);font-size:.78rem;margin-top:16px}
        .banner{padding:64px 0;background:var(--night);text-align:center}
        .banner__text{font-size:clamp(1.6rem,3vw,2rem);font-weight:700;color:var(--cream)}
        .banner__sub{font-size:clamp(1rem,2vw,1.2rem);color:var(--warm-glow);opacity:.7;letter-spacing:8px;margin-top:8px}
        .footer{padding:36px 0;background:var(--night);border-top:1px solid rgba(255,255,255,.04)}
        .footer__inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
        .footer__brand{font-size:1rem;font-weight:700;color:var(--cream);letter-spacing:1px}
        .footer__tagline{font-size:.78rem;color:rgba(250,246,240,.25)}
        .footer__copy{font-size:.85rem;color:rgba(250,246,240,.2)}
        @media(max-width:640px){.section{padding:64px 0}.about__cards{grid-template-columns:1fr}.join__card{padding:32px 24px}}
      }</style>

      <header className="hero">
        <div className="hero__bg">
          {[[10,20,8,0],[25,60,5,2],[45,15,6,4],[65,55,4,1],[80,30,7,3],[90,70,5,5],[35,80,6,2.5],[55,40,4,4.5]].map(([l,t,w,d],i) => (
            <div key={i} className="particle" style={{left:l+"%",top:t+"%",width:w+"px",height:w+"px",animationDelay:d+"s"}} />
          ))}
        </div>
        <nav className={"nav"+(scrolled?" scrolled":"")}>
          <div className="nav__inner">
            <span className="nav__logo">低谷渡口</span>
            <div className="nav__links">
              {user ? (
                <a href="/dashboard" className="nav__cta">进入社群</a>
              ) : (
                <><a href="/login">登录</a><a href="/login" className="nav__cta">加入社群</a></>
              )}
            </div>
          </div>
        </nav>
        <div className="hero__body">
          <div className="container">
            <div className="hero__text">
              <div className="hero__badge">一个安静的陪伴社群</div>
              <h1 className="hero__title">低谷渡口<span className="hero__subtitle">你不是一个人</span></h1>
              <p className="hero__desc">这里没有"你应该振作起来"，没有贩卖焦虑。<br />只有一群懂你的人。</p>
              <div className="hero__actions">
                <a href="#about" className="btn btn--primary">了解我们</a>
                {!user ? <a href="/login" className="btn btn--ghost">加入等候 →</a> : <a href="/dashboard" className="btn btn--ghost">进入社群 →</a>}
              </div>
            </div>
          </div>
        </div>
        <div className="hero__wave"><svg viewBox="0 0 1440 100" fill="none" preserveAspectRatio="none"><path d="M0 40Q360 90 720 40T1440 40V100H0V40Z" fill="#faf6f0"/></svg></div>
      </header>

      <section className="section anim" id="about">
        <div className="container">
          <h2 className="section__title">低谷渡口是</h2>
          <div className="about__cards">
            {sections[0].cards.map((c,i) => (
              <div key={i} className="about__card anim">
                <span className="about__icon">{c.icon}</span>
                <h3>{c.title}</h3>
                <p>{c.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section className="section section--cream anim" id="who">
        <div className="container">
          <h2 className="section__title">这里适合</h2>
          <div className="who__list">
            {whoItems.map(([emoji,title,desc],i) => (
              <div key={i} className="who__item anim">
                <span className="who__emoji">{emoji}</span>
                <div><strong>{title}</strong><p>{desc}</p></div>
              </div>
            ))}
          </div>
          <div className="who__note"><p>如果你不在这些标签里，但也需要一个安静的地方——<br /><strong>你也欢迎。这里没有门槛。</strong></p></div>
        </div>
      </section>

      <section className="section anim" id="features">
        <div className="container">
          <h2 className="section__title">这里有什么</h2>
          <p className="section__subtitle">没有复杂的系统，只有几个温暖的小工具</p>
          <div className="features__grid">
            {features.map((f,i) => (
              <div key={i} className="feature-card anim">
                <div className="fc-icon">{f.icon}</div>
                <h3>{f.title}</h3>
                <p>{f.desc}</p>
                <p className="fc-footnote"><strong>{f.note}</strong></p>
              </div>
            ))}
          </div>
          <div className="covenant anim">
            <blockquote>"这里是低谷渡口。<br />你可以停下来休息，没有人会催你走。<br />等你准备好了——<br />回头看看，我们还在你身后。"</blockquote>
            <cite>— 低谷渡口 · 社群公约</cite>
          </div>
        </div>
      </section>

      <section className="section section--join anim" id="join">
        <div className="container">
          <div className="join__card">
            <h2 className="join__title">加入等候</h2>
            <p className="join__desc">社群正在搭建，预计首批开放 <strong>200 个名额</strong>。<br />留个联系方式，上线后第一个告诉你。</p>
            <form className="join__form" onSubmit={handleJoin}>
              <input name="name" placeholder="怎么称呼你（选填）" className="join__input" />
              <input name="contact" placeholder="微信 / 邮箱（以便我们找到你）" className="join__input" required />
              <button type="submit" className="btn btn--primary btn--block">🌿 带我一起</button>
            </form>
            <p className="join__footnote">你的信息仅用于上线通知，不会对外公开。</p>
          </div>
        </div>
      </section>

      <section className="banner">
        <div className="container"><p className="banner__text">低谷渡口</p><p className="banner__sub">你不是一个人</p></div>
      </section>

      <footer className="footer">
        <div className="container footer__inner">
          <div><span className="footer__brand">低谷渡口</span><p className="footer__tagline">一个安静的陪伴社群</p></div>
          <p className="footer__copy">每个人都在渡自己的河，但我们可以一起渡一段。</p>
        </div>
      </footer>
    </>
  );
}